.venv/
__pycache__/
# evaluation inputs/outputs: third-party human texts + generated AI texts (re-creatable with eval/*.py)
eval/data/
eval/scores.json
eval/sites/zerogpt_sample.json
data/
# training/test corpora + model checkpoints (rebuilt by train/build_data.py, train/gen_train.py, train/train.py)
train/raw/
train/data/
test/
eval/runs/
models/
.venv-lightning/
eval/sol/*/downloads/
# generated per user (train/kaggle/push.sh)
train/kaggle/kernel-metadata.json
# Runpod run records (pod ids, prices)
train/runpod/ledger.jsonl
train/runpod/watchdog.log
# third-party / generated test texts: not redistributed (rebuild with the scripts next to them)
eval/sol/*/texts.json
eval/sol/*/results.json
eval/sol/*/humans.json
eval/sol/*/self_ai.json
eval/sol/*/generation/
eval/sol/*/evaluation.log
eval/sol/*/comparison.html
eval/sol/*/probe_*.json
eval/sites/results.json
.public-guard.local
.venv-lightning/
eval/sol/*/round1-results.json
eval/sol/*/summary.json
eval/sol/*/interim.html
eval/sol/*/*.log
eval/sol/*/models.json
eval/sol/*/audit.json
eval/sol/*/zerogpt.json
eval/sol/*/proxy_ai.json
eval/sol/*/*candidates*.json
eval/sol/*/PHASE_A.md
# Sol round folders: only REPORT.md, ANALYSIS_PLAN.md, manifest.json and scripts are published
eval/sol/*/round*-results.json
eval/sol/*/*summary*.json
eval/sol/*/*.html
eval/sol/*/phase_*.md
eval/sol/*/*audit*.json
